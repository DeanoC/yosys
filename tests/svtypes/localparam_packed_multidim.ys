read_verilog -sv localparam_packed_multidim.sv
prep -top top -flatten
async2sync
sat -verify -prove-asserts

design -reset

# Array query functions on dynamically indexed 1-D ranged parameters. These
# used to fail with "Dimension 2 out of range".
read_verilog -sv <<EOT
module top (
	input logic [1:0] a
);
	localparam logic [7:0] P = 8'hA5;
	localparam logic [0:7] P_UP = 8'hA5;
	logic [7:0] p_w;
	assign p_w = P;

	always_comb assert($bits(P[a]) == 1);
	always_comb assert($size(P[a]) == 1);
	always_comb assert($dimensions(P[a]) == 1);
	always_comb assert($left(P[a]) == 0 && $right(P[a]) == 0);
	always_comb assert($bits(P_UP[a]) == 1);
	always_comb assert($bits(P[a +: 2]) == 2 && $size(P[a +: 2]) == 2);
	always_comb assert($bits(P[a -: 2]) == 2);
	always_comb assert(P[a] == p_w[a]);
	always_comb assert(P[a +: 2] == p_w[a +: 2]);
endmodule
EOT
prep -top top
async2sync
sat -verify -prove-asserts

design -reset

# $unit-scope declarations are appended after the module items, so the module
# declarations below use these parameters before they are simplified. This used
# to loop forever. GW, GB and G are only built from literals and get resolved on
# demand; G_N and G_D (non-literal ranges) are resolved on a later pass.
read_verilog -sv <<EOT
localparam logic [1:0][3:0] GW = {4'h2, 4'h7};
localparam logic [2:0][1:0] GB = 6'h15;
localparam logic [1:0][3:0] G = {4'h3, 4'h5};
localparam int N = 2;
localparam logic [N-1:0][3:0] G_N = {4'h6, 4'h9};
localparam logic [N-1:0][3:0] G_D = 8'hC4;

module top (
	input  logic       sel,
	output logic [3:0] o
);
	logic [GW[1]:0] w_gw;
	logic [$bits(GB)-1:0] w_gb;
	localparam logic [3:0] X = G[1];
	localparam logic [3:0] X_N = G_N[0];
	localparam logic [3:0] X_D = G_D[1];
	localparam int B = $bits(G);
	localparam int B_N = $bits(G_N);
	localparam int S_N = $size(G_N, 1);
	logic [G[0]:0] w;
	logic [$bits(G)-1:0] w_bits;
	logic [G_N[1]-1:0] w_n;
	assign o = G[sel];

	always_comb assert($bits(w_gw) == 3);
	always_comb assert($bits(w_gb) == 6);
	always_comb assert(X == 4'h3);
	always_comb assert(X_N == 4'h9);
	always_comb assert(X_D == 4'hC);
	always_comb assert(B == 8 && B_N == 8 && S_N == 2);
	always_comb assert($bits(w) == 6);
	always_comb assert($bits(w_bits) == 8);
	always_comb assert($bits(w_n) == 6);
	always_comb assert(o == (sel ? 4'h3 : 4'h5));
endmodule
EOT
prep -top top
async2sync
sat -verify -prove-asserts

design -reset

# Array query functions on multi-dimension part-selected packed parameters
# (both in constant expressions and runtime contexts).
read_verilog -sv <<EOT
module top (
	input logic [1:0] a
);
	localparam logic [3:0][3:0] T = {4'hA, 4'hB, 4'hC, 4'hD};
	localparam logic [0:3][3:0] T_UP = {4'hA, 4'hB, 4'hC, 4'hD};
	localparam logic [3:0][2:0][7:0] M = {
		24'h112233, 24'h445566, 24'h778899, 24'hAABBCC
	};

	localparam int B_TT = $bits(T[2:1][2:1]);
	localparam int D_TT = $dimensions(T[2:1][2:1]);
	localparam int L1_TT = $left(T[2:1][2:1], 1);
	localparam int R1_TT = $right(T[2:1][2:1], 1);
	localparam int L2_TT = $left(T[2:1][2:1], 2);
	localparam int R2_TT = $right(T[2:1][2:1], 2);
	localparam int B_TI = $bits(T[2:1][0]);
	localparam int D_TI = $dimensions(T[2:1][0]);
	localparam int B_M3 = $bits(M[2:1][0][5:2]);
	localparam int D_M3 = $dimensions(M[2:1][0][5:2]);
	localparam int B_M2 = $bits(M[2:1][0]);
	localparam int D_M2 = $dimensions(M[2:1][0]);
	localparam logic [3:0] P_TT = T[2:1][2:1];
	localparam logic [1:0] P_TI = T[2:1][0];
	localparam logic [3:0] P_UP = T_UP[1:2][2:1];
	localparam logic [7:0] P_M3 = M[2:1][0][5:2];
	localparam logic [15:0] P_M3_2 = M[2:1][1:0][5:2];

	always_comb assert(B_TT == 4 && D_TT == 2 && L1_TT == 2 && R1_TT == 1 && L2_TT == 2 && R2_TT == 1);
	always_comb assert(B_TI == 2 && D_TI == 1);
	always_comb assert(B_M3 == 8 && D_M3 == 2 && B_M2 == 16 && D_M2 == 2);
	always_comb assert(P_TT == 4'b0110 && P_TI == 2'b10 && P_UP == 4'b0110);
	always_comb assert(P_M3 == {M[2][0][5:2], M[1][0][5:2]});
	always_comb assert(P_M3_2 == {M[2][1][5:2], M[2][0][5:2], M[1][1][5:2], M[1][0][5:2]});
	always_comb assert({T[2:1][2:1]} == 4'b0110 && {T[2:1][0]} == 2'b10);
	always_comb assert({T_UP[1:2][2:1]} == 4'b0110);
	always_comb if (a <= 2'd2) assert(T[a +: 2][2:1] == {T[a + 2'd1][2:1], T[a][2:1]});
	always_comb assert($bits(T[2:1][2:1]) == 4 && $dimensions(T[2:1][2:1]) == 2);
	always_comb assert($size(T[2:1][2:1], 1) == 2 && $size(T[2:1][2:1], 2) == 2);
	always_comb assert($bits(T[2:1][0]) == 2 && $dimensions(T[2:1][0]) == 1);
	always_comb assert($left(T[2:1][0]) == 2 && $right(T[2:1][0]) == 1);
	always_comb assert($bits(T[a +: 2][2:1]) == 4 && $dimensions(T[a +: 2][2:1]) == 2);
	always_comb assert($bits(M[2:1][0][5:2]) == 8 && $dimensions(M[2:1][0][5:2]) == 2);
	always_comb assert($size(M[2:1][0][5:2], 1) == 2 && $size(M[2:1][0][5:2], 2) == 4);
	always_comb assert($bits(M[2:1][0]) == 16 && $dimensions(M[2:1][0]) == 2);
	always_comb assert($size(M[2:1][0], 1) == 2 && $size(M[2:1][0], 2) == 8);
endmodule
EOT
prep -top top
async2sync
sat -verify -prove-asserts

design -reset

# Parameters with a declared range, initialized from part-selects of a packed
# multidimensional parameter. The declared range governs: the slice dimensions
# of the initializer must not leak into the parameter value or into copies of
# it, so array queries report the declared range (e.g. $size(P_TT) is 4, not
# the 2 of the T[2:1][2:1] slice).
read_verilog -sv <<EOT
module top;
	localparam logic [3:0][3:0] T = {4'hA, 4'hB, 4'hC, 4'hD};

	localparam logic [7:0] P_SL = T[2:1];
	localparam logic [1:0] P_RS = T[3][2:1];
	localparam logic [3:0] P_TT = T[2:1][2:1];
	localparam logic [1:0] P_TI = T[2:1][0];
	localparam logic [1:0][1:0] P_2D = T[2:1][2:1];
	localparam P_IMP = T[2:1][2:1];
	localparam logic [7:0] P_SL_CP = P_SL;
	localparam logic [3:0] P_TT_CP = P_TT;
	localparam logic [3:0] P_2D_CP = P_2D;
	localparam logic [3:0] P_IMP_CP = P_IMP;

	localparam int S_SL  = $size(P_SL);
	localparam int L_SL  = $left(P_SL);
	localparam int R_SL  = $right(P_SL);
	localparam int H_SL  = $high(P_SL);
	localparam int LO_SL = $low(P_SL);
	localparam int D_SL  = $dimensions(P_SL);
	localparam int B_SL  = $bits(P_SL);
	localparam int S_TT  = $size(P_TT);
	localparam int L_TT  = $left(P_TT);
	localparam int R_TT  = $right(P_TT);
	localparam int D_TT  = $dimensions(P_TT);
	localparam int L_TI  = $left(P_TI);
	localparam int R_TI  = $right(P_TI);
	localparam int L_CP  = $left(P_TT_CP);
	localparam int D_CP  = $dimensions(P_TT_CP);

	always_comb assert(P_SL == 8'hBC && P_RS == 2'b01 && P_TT == 4'b0110 && P_TI == 2'b10);
	always_comb assert(P_2D == 4'b0110 && P_IMP == 4'b0110);
	always_comb assert(P_SL_CP == 8'hBC && P_TT_CP == 4'b0110 && P_2D_CP == 4'b0110 && P_IMP_CP == 4'b0110);

	always_comb assert(S_SL == 8 && L_SL == 7 && R_SL == 0 && H_SL == 7 && LO_SL == 0 && D_SL == 1 && B_SL == 8);
	always_comb assert(S_TT == 4 && L_TT == 3 && R_TT == 0 && D_TT == 1);
	always_comb assert(L_TI == 1 && R_TI == 0);
	always_comb assert(L_CP == 3 && D_CP == 1);

	always_comb assert($size(P_RS) == 2 && $left(P_RS) == 1 && $right(P_RS) == 0 && $dimensions(P_RS) == 1);
	always_comb assert($size(P_TT) == 4 && $high(P_TT) == 3 && $low(P_TT) == 0 && $bits(P_TT) == 4);
	always_comb assert($size(P_TI) == 2 && $dimensions(P_TI) == 1);
	always_comb assert($size(P_SL_CP) == 8 && $left(P_SL_CP) == 7 && $right(P_SL_CP) == 0 && $dimensions(P_SL_CP) == 1);
	always_comb assert($size(P_TT_CP) == 4 && $right(P_TT_CP) == 0);
	always_comb assert($dimensions(P_2D) == 2 && $size(P_2D, 1) == 2 && $left(P_2D, 1) == 1 && $right(P_2D, 1) == 0);
	always_comb assert($size(P_2D_CP) == 4 && $left(P_2D_CP) == 3 && $right(P_2D_CP) == 0 && $dimensions(P_2D_CP) == 1);
	always_comb assert($size(P_IMP_CP) == 4 && $left(P_IMP_CP) == 3 && $right(P_IMP_CP) == 0 && $dimensions(P_IMP_CP) == 1);
endmodule
EOT
prep -top top
async2sync
sat -verify -prove-asserts


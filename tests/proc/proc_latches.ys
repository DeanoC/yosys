# warn
read_verilog <<EOT
module top(input g, rn, d, output reg q);
always @* if (~rn) q <= 0; else if (g) q <= d;
endmodule
EOT
logger -expect warning "Latch inferred for signal" 1
proc
logger -check-expected

design -reset

# info
read_verilog <<EOT
module top(input g, rn, d, output reg q);
always @* if (~rn) q <= 0; else if (g) q <= d;
endmodule
EOT
logger -expect-no-warnings
proc -latches info
logger -check-expected

design -reset

# always_latch is exempt
read_verilog -sv <<EOT
module top(input g, d, output reg q);
always_latch if (g) q <= d;
endmodule
EOT
logger -expect-no-warnings
logger -expect log "Latch inferred for signal .* from always_latch process" 1
proc -latches error
logger -check-expected
select -assert-count 1 t:$dlatch a:always_latch %i

design -reset

# nomerge on always_latch processes must survive proc and prevent opt_merge.
read_verilog -sv <<EOT
module top(input en, d, output reg q0, q1);
(* nomerge=1 *) always_latch if (en) q0 <= d;
(* nomerge=1 *) always_latch if (en) q1 <= d;
endmodule
EOT
hierarchy -top top
proc
select -assert-count 2 t:$dlatch a:nomerge %i
opt_merge
select -assert-count 2 t:$dlatch a:nomerge %i

design -reset

# error
read_verilog <<EOT
module top(input g, rn, d, output reg q);
always @* if (~rn) q <= 0; else if (g) q <= d;
endmodule
EOT
logger -expect error "Latch inferred for signal" 1
proc -latches error

# (* nomerge *) on a latch process stays on the inferred latch and the
# private enable/data cone. Unmarked latches, nomerge=0, and public
# registers that feed those latches still merge.

design -reset
read_verilog -sv <<EOF
module top(input en, d, output logic q0, q1);
  always_latch if (en) q0 <= d;
  always_latch if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 1 t:$dlatch
select -assert-count 0 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, d, output logic q0, q1);
  (* nomerge=1 *) always_latch if (en) q0 <= d;
  (* nomerge=1 *) always_latch if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 2 t:$dlatch
select -assert-count 2 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, d, output logic q0, q1);
  (* nomerge=0 *) always_latch if (en) q0 <= d;
  (* nomerge=0 *) always_latch if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 1 t:$dlatch
select -assert-count 0 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, d, output logic q0, q1);
  (* nomerge=1 *) always_latch if (en) q0 <= d;
  always_latch if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 2 t:$dlatch
select -assert-count 1 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, sel, a, b, output logic q0, q1);
  (* nomerge=1 *) always_latch if (en) q0 <= sel ? a : b;
  (* nomerge=1 *) always_latch if (en) q1 <= sel ? a : b;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 2 t:$dlatch a:nomerge %i
select -assert-count 2 t:$mux a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, a, b, output logic q0, q1);
  (* nomerge=1 *) always_latch if (en) q0 <= a & b;
  (* nomerge=1 *) always_latch if (en) q1 <= a & b;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 2 t:$dlatch a:nomerge %i
select -assert-count 2 t:$and a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input clk, en, d, output logic q0, q1, page_o, page2_o);
  logic page = 0, page2 = 0;
  always @(posedge clk) page <= d;
  always @(posedge clk) page2 <= d;
  (* nomerge=1 *) always_latch if (en) q0 <= page;
  (* nomerge=1 *) always_latch if (en) q1 <= page;
  assign page_o = page;
  assign page2_o = page2;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 1 t:$dff
select -assert-count 0 t:$dff a:nomerge %i
select -assert-count 2 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input clk, en, d, output logic q0, q1);
  logic page = 0, page2 = 0;
  always @(posedge clk) page <= d;
  always @(posedge clk) page2 <= d;
  (* nomerge=1 *) always_latch if (en) q0 <= page;
  (* nomerge=1 *) always_latch if (en) q1 <= page2;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 1 t:$dff
select -assert-count 0 t:$dff a:nomerge %i
select -assert-count 2 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, d, output logic q0, q1);
  (* nomerge=1 *) always @* if (en) q0 <= d;
  (* nomerge=1 *) always @* if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 2 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, d, output logic q0, q1);
  always @* if (en) q0 <= d;
  always @* if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 1 t:$dlatch
select -assert-count 0 t:$dlatch a:nomerge %i

design -reset
read_verilog -sv <<EOF
module top(input en, rn, d, output logic q0, q1);
  (* nomerge=1 *) always @* if (!rn) q0 <= 0; else if (en) q0 <= d;
  (* nomerge=1 *) always @* if (!rn) q1 <= 0; else if (en) q1 <= d;
endmodule
EOF
hierarchy -top top
proc -latches info
opt_merge
opt_clean
select -assert-count 2 t:$adlatch a:nomerge %i

# (* nomerge *) on a wire keeps the private cone that drives it.
# (* keep *) on a wire does not. Unmarked logic still merges.

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  wire h0 = a == b;
  wire h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  (* nomerge *) wire h0 = a == b;
  (* nomerge *) wire h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 2 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  (* nomerge=0 *) wire h0 = a == b;
  (* nomerge=0 *) wire h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  (* keep *) wire h0 = a == b;
  (* keep *) wire h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output [2:0] y);
  (* nomerge *) wire h0 = a == b;
  wire h1 = a == b;
  wire h2 = a == b;
  assign y = {h0, h1, h2};
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 2 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output [2:0] y);
  (* nomerge *) wire [2:0] hit;
  assign hit[0] = a == b;
  assign hit[1] = a == b;
  assign hit[2] = a == b;
  assign y = hit;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 3 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input en, input [1:0] a, b, output y);
  (* nomerge *) wire h0 = en && (a == b);
  (* nomerge *) wire h1 = en && (a == b);
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 2 t:$eq
select -assert-count 2 t:$logic_and

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  logic h0, h1;
  always_comb h0 = a == b;
  always_comb h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  logic h0, h1;
  (* nomerge=1 *) always_comb h0 = a == b;
  (* nomerge=1 *) always_comb h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 2 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, output y);
  logic h0, h1;
  (* nomerge=0 *) always_comb h0 = a == b;
  (* nomerge=0 *) always_comb h1 = a == b;
  assign y = h0 ^ h1;
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, input en0, en1, output [1:0] y);
  logic public0, public1, h0, h1;
  always_comb public0 = a == b;
  always_comb public1 = a == b;
  (* nomerge=1 *) always_comb h0 = public0 && en0;
  (* nomerge=1 *) always_comb h1 = public1 && en1;
  assign y = {h0, h1};
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$eq
select -assert-count 2 t:$logic_and

design -reset
read_verilog -sv <<EOF
module top(input clk, input [1:0] d, a, output [1:0] y);
  reg [1:0] page = 0, page2 = 0;
  always @(posedge clk) page <= d;
  always @(posedge clk) page2 <= d;
  (* nomerge *) wire hit = page == a;
  assign y = {hit, page2[0]};
endmodule
EOF
hierarchy -top top
proc
opt_merge
opt_clean
select -assert-count 1 t:$dff
select -assert-count 1 t:$eq

design -reset
read_verilog -sv <<EOF
module top(input [1:0] a, b, c, d, output [1:0] y);
  (* nomerge *) wire h0 = a == b;
  wire h1 = a == b;
  wire h2 = c == d;
  wire h3 = c == d;
  assign y = {h0 ^ h1, h2 ^ h3};
endmodule
EOF
hierarchy -top top
proc
select top/h0
opt_merge
select -clear
setattr -unset nomerge top/h0
opt_merge
opt_clean
select -assert-count 2 t:$eq

# (* keep *) preserves private wires without making them boundaries.
design -reset
read_rtlil <<EOF
module \top
  wire width 2 input 1 \a
  wire width 2 input 2 \b
  wire width 1 input 3 \en0
  wire width 1 input 4 \en1
  attribute \keep 1
  wire width 1 $h0
  attribute \keep 1
  wire width 1 $h1
  attribute \nomerge 1
  wire width 1 output 5 \y0
  attribute \nomerge 1
  wire width 1 output 6 \y1
  cell $eq $eq0
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 2
    parameter \B_WIDTH 2
    parameter \Y_WIDTH 1
    connect \A \a
    connect \B \b
    connect \Y $h0
  end
  cell $eq $eq1
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 2
    parameter \B_WIDTH 2
    parameter \Y_WIDTH 1
    connect \A \a
    connect \B \b
    connect \Y $h1
  end
  cell $and $and0
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 1
    parameter \B_WIDTH 1
    parameter \Y_WIDTH 1
    connect \A $h0
    connect \B \en0
    connect \Y \y0
  end
  cell $and $and1
    parameter \A_SIGNED 0
    parameter \B_SIGNED 0
    parameter \A_WIDTH 1
    parameter \B_WIDTH 1
    parameter \Y_WIDTH 1
    connect \A $h1
    connect \B \en1
    connect \Y \y1
  end
end
EOF
opt_merge
select -assert-count 2 t:$eq
select -assert-count 2 t:$and

read_verilog tribuf_shared_pads.v
synth_intel_alm -family cyclonev -top shared_alias -noclkbuf
cd shared_alias
# Both sibling outputs are independent tri-state pads, sharing only I/OE.
select -assert-count 2 t:MISTRAL_IO
select -assert-count 2 t:MISTRAL_IB
select -assert-none t:MISTRAL_OB t:$_TBUF_ i:pad i:a_rb
select -assert-count 1 w:pad %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 1 w:a_rb %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 1 w:pad %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:a_rb %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:a_rb %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i

design -reset
read_verilog tribuf_shared_pads.v
synth_intel_alm -family cyclonev -top shared_alias_read -noclkbuf
cd shared_alias_read
# Stop alias tracing at each driven output so explicit reads use its own O.
select -assert-count 2 t:MISTRAL_IO
select -assert-count 2 t:MISTRAL_IB
select -assert-count 2 t:MISTRAL_OB
select -assert-none t:$_TBUF_ i:pad i:a_rb i:pad_rb i:other_rb
select -assert-count 1 w:pad %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 1 w:a_rb %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 1 w:pad_rb %x:+[PAD] t:MISTRAL_OB %i
select -assert-count 1 w:other_rb %x:+[PAD] t:MISTRAL_OB %i
select -assert-count 1 w:pad %x:+[PAD] t:MISTRAL_IO %i %co1:+[O] w:* %i w:pad_rb %x:+[PAD] t:MISTRAL_OB %i %ci1:+[I] w:* %i %i
select -assert-count 1 w:a_rb %x:+[PAD] t:MISTRAL_IO %i %co1:+[O] w:* %i w:other_rb %x:+[PAD] t:MISTRAL_OB %i %ci1:+[I] w:* %i %i
select -assert-none w:pad %x:+[PAD] t:MISTRAL_IO %i %co1:+[O] w:* %i w:other_rb %x:+[PAD] t:MISTRAL_OB %i %ci1:+[I] w:* %i %i

design -reset
read_verilog tribuf_shared_pads.v
synth_intel_alm -family cyclonev -top shared_alias_bus -noclkbuf
cd shared_alias_bus
select -assert-count 4 t:MISTRAL_IO
select -assert-count 3 t:MISTRAL_IB
select -assert-none t:MISTRAL_OB t:$_TBUF_ i:pad i:a_rb
splitnets -ports
select -assert-count 2 w:pad* %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 2 w:a_rb* %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 1 w:pad[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d[0] %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d[1] %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:a_rb[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d[1] %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:a_rb[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d[0] %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:a_rb[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:a_rb[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i

read_verilog hps_fpga2sdram.v
synth_intel_alm -family cyclonev -nobram -nolutram -nodsp -noiopad -noclkbuf -top top
cd top
select -assert-count 1 t:cyclonev_hps_interface_fpga2sdram
select -assert-count 1 t:cyclonev_hps_interface_fpga2sdram %ci:+[cmd_data_0] w:address %i
select -assert-count 1 t:cyclonev_hps_interface_fpga2sdram %co:+[rd_data_1] w:rd_data_1 %i
select -assert-count 1 t:cyclonev_hps_interface_fpga2sdram %co:+[rd_valid_2] w:valid1 %i

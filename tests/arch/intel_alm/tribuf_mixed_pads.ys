read_verilog tribuf_mixed_pads.v
synth_intel_alm -family cyclonev -top tribuf_mixed_pads -noclkbuf
cd tribuf_mixed_pads
select -assert-none t:$_TBUF_
select -assert-count 4 t:MISTRAL_IO
select -assert-count 3 t:MISTRAL_IB
select -assert-count 2 t:MISTRAL_OB
select -assert-none i:pad i:pad_hi i:rb i:rb_hi
# Expose individual bus bits for connectivity assertions.
splitnets -ports
# Read-back must come from the tri-state pad, not its data input.
select -assert-count 1 w:pad[0] %x:+[PAD] t:MISTRAL_IO %i %co1:+[O] w:* %i w:rb %x:+[PAD] t:MISTRAL_OB %i %ci1:+[I] w:* %i %i
select -assert-count 1 w:pad_hi[1] %x:+[PAD] t:MISTRAL_IO %i %co1:+[O] w:* %i w:rb_hi %x:+[PAD] t:MISTRAL_OB %i %ci1:+[I] w:* %i %i
# Each tri-state bit takes data and enable from the intended input buffer.
select -assert-count 1 w:pad[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad_hi[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:d %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad_hi[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i w:en %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
# Always-driven bits retain x as their data and a constant high enable.
select -assert-count 1 w:pad[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:x %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-count 1 w:pad_hi[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[I] w:* %i w:x %x:+[PAD] t:MISTRAL_IB %i %co1:+[O] w:* %i %i
select -assert-none w:pad[1] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i
select -assert-none w:pad_hi[0] %x:+[PAD] t:MISTRAL_IO %i %ci1:+[OE] w:* %i

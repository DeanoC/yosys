read_verilog tribuf_hierarchy.v
synth_intel_alm -family cyclonev -top tribuf_hierarchy -noflatten -noclkbuf
cd tribuf_hierarchy
# Pad mapping is top-only. The child's output must not be promoted and then
# required to have a pad in the child; top-level read-back is still mapped.
select -assert-count 1 t:tribuf_child
select -assert-count 1 t:MISTRAL_IO
select -assert-count 3 t:MISTRAL_OB
select -assert-count 2 t:MISTRAL_IB
select -assert-none t:$_TBUF_ i:child_pad i:child_rb i:top_pad i:top_rb
select -assert-count 1 w:top_pad %x:+[PAD] t:MISTRAL_IO %i
select -assert-count 1 w:top_rb %x:+[PAD] t:MISTRAL_OB %i
select -assert-count 1 w:top_pad %x:+[PAD] t:MISTRAL_IO %i %co1:+[O] w:* %i w:top_rb %x:+[PAD] t:MISTRAL_OB %i %ci1:+[I] w:* %i %i
cd tribuf_child
select -assert-none t:MISTRAL_IO t:MISTRAL_IB t:MISTRAL_OB i:pad i:rb
select -assert-count 1 t:$_TBUF_

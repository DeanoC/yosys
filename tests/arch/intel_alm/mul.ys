read_verilog ../common/mul.v
chparam -set X_WIDTH 8 -set Y_WIDTH 8 -set A_WIDTH 16
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL9X9
select -assert-none t:MISTRAL_MUL9X9 %% t:* %D

design -reset
read_verilog ../common/mul.v
chparam -set X_WIDTH 17 -set Y_WIDTH 17 -set A_WIDTH 34
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL18X18
select -assert-none t:MISTRAL_MUL18X18 %% t:* %D

design -reset
read_verilog ../common/mul.v
chparam -set X_WIDTH 26 -set Y_WIDTH 26 -set A_WIDTH 52
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL27X27
select -assert-none t:MISTRAL_MUL27X27 %% t:* %D

# Signedness must reach the MISTRAL_MUL cells. The Cyclone V DSP has no width
# headroom, so a full-width unsigned operand needs the block's unsigned mode and
# a product mul2dsp splits has unsigned low slices. dsp_sim.v defaults to
# signed, matching nextpnr-mistral, so dropping the parameters fails here.
design -reset
read_verilog <<EOT
module top(input [8:0] x, input [8:0] y, output [17:0] A); assign A = x * y; endmodule
EOT
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL9X9
select -assert-count 1 t:MISTRAL_MUL9X9 r:A_SIGNED=0 %i
select -assert-count 1 t:MISTRAL_MUL9X9 r:B_SIGNED=0 %i

design -reset
read_verilog <<EOT
module top(input signed [8:0] x, input signed [8:0] y, output signed [17:0] A); assign A = x * y; endmodule
EOT
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL9X9
select -assert-count 1 t:MISTRAL_MUL9X9 r:A_SIGNED=1 %i
select -assert-count 1 t:MISTRAL_MUL9X9 r:B_SIGNED=1 %i

design -reset
read_verilog <<EOT
module top(input [17:0] x, input [17:0] y, output [35:0] A); assign A = x * y; endmodule
EOT
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL18X18
select -assert-count 1 t:MISTRAL_MUL18X18 r:A_SIGNED=0 %i
select -assert-count 1 t:MISTRAL_MUL18X18 r:B_SIGNED=0 %i

design -reset
read_verilog <<EOT
module top(input [26:0] x, input [26:0] y, output [53:0] A); assign A = x * y; endmodule
EOT
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL27X27
select -assert-count 1 t:MISTRAL_MUL27X27 r:A_SIGNED=0 %i
select -assert-count 1 t:MISTRAL_MUL27X27 r:B_SIGNED=0 %i

# A 28-bit operand is split: mul2dsp feeds its low 27 bits to MISTRAL_MUL27X27
# as an unsigned A (B keeps the product's signedness) and builds the top-bit
# partial product and the sum in ALMs. Prove the assembled product against the
# RTL with the ALM and DSP models. sat encodes $mul as one shifted copy of A per
# bit of B. With the narrow, sign-extended operand on B, a negative y adds
# dozens of copies of x and the proof does not finish, so swap the $mul operands
# first ($mul is commutative).
design -reset
read_verilog -icells <<EOT
(* techmap_celltype = "$mul" *)
module mul_swap(A, B, Y);
	parameter A_SIGNED = 0;
	parameter B_SIGNED = 0;
	parameter A_WIDTH = 1;
	parameter B_WIDTH = 1;
	parameter Y_WIDTH = 1;
	input [A_WIDTH-1:0] A;
	input [B_WIDTH-1:0] B;
	output [Y_WIDTH-1:0] Y;
	\$__mul_swapped #(.A_SIGNED(B_SIGNED), .B_SIGNED(A_SIGNED), .A_WIDTH(B_WIDTH), .B_WIDTH(A_WIDTH), .Y_WIDTH(Y_WIDTH)) _TECHMAP_REPLACE_ (.A(B), .B(A), .Y(Y));
endmodule
EOT
design -stash mul_swap

design -reset
read_verilog <<EOT
module top(input signed [27:0] x, input signed [3:0] y, output signed [31:0] A); assign A = x * y; endmodule
EOT
hierarchy -top top
proc
equiv_opt -run :prove -map +/intel_alm/common/alm_sim.v -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf
miter -equiv -flatten -make_assert gold gate miter
techmap -map %mul_swap miter/t:$mul
chtype -map $__mul_swapped $mul miter
sat -verify -prove-asserts -show-inputs miter # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL27X27
select -assert-count 1 t:MISTRAL_MUL27X27 r:A_SIGNED=0 %i
select -assert-count 1 t:MISTRAL_MUL27X27 r:B_SIGNED=1 %i

design -reset
read_verilog <<EOT
module top(input [27:0] x, input [3:0] y, output [31:0] A); assign A = x * y; endmodule
EOT
hierarchy -top top
proc
equiv_opt -run :prove -map +/intel_alm/common/alm_sim.v -map +/intel_alm/common/dsp_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf
miter -equiv -flatten -make_assert gold gate miter
techmap -map %mul_swap miter/t:$mul
chtype -map $__mul_swapped $mul miter
sat -verify -prove-asserts -show-inputs miter # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

select -assert-count 1 t:MISTRAL_MUL27X27
select -assert-count 1 t:MISTRAL_MUL27X27 r:A_SIGNED=0 %i
select -assert-count 1 t:MISTRAL_MUL27X27 r:B_SIGNED=0 %i

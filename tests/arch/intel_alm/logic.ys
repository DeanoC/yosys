read_verilog ../common/logic.v
hierarchy -top top
proc
equiv_opt -assert -map +/intel_alm/common/alm_sim.v synth_intel_alm -family cyclonev -noiopad -noclkbuf # equivalency check
design -load postopt # load the post-opt design (otherwise equiv_opt loads the pre-opt design)
cd top # Constrain all select calls below inside the top module

# B6 (XNOR) is its own ALUT2. Cone isolation maps it separately from B5 (XOR),
# so ABC no longer folds the pair into one ALUT2 plus a MISTRAL_NOT.
select -assert-count 3 t:MISTRAL_NOT
select -assert-count 4 t:MISTRAL_ALUT2
select -assert-count 2 t:MISTRAL_ALUT4
select -assert-none t:MISTRAL_NOT t:MISTRAL_ALUT2 t:MISTRAL_ALUT4 %% t:* %D
